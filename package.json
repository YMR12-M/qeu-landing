{
  "name": "qeu-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Landing page for the Qeu (كيو | Q) grocery deals app — Arabic (default) + English, statically pre-rendered.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && npm run prerender",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entry-server.jsx --outDir dist/server",
    "prerender": "node scripts/prerender.js",
    "preview": "vite preview --outDir dist/client",
    "lint": "eslint .",
    "format": "prettier --write .",
    "qr": "node scripts/generate-qr.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/tajawal": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "qrcode": "^1.5.4",
    "vite": "^8.3.0",
    "vite-imagetools": "^12.0.1"
  }
}
